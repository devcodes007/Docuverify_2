# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins for CORS. In development
# localhost:8080/5173 are always allowed in addition to whatever's listed
# here; in production ONLY the origins listed here are allowed (never *).
CORS_ORIGINS=https://your-frontend.vercel.app
# Rebuilds BM25 + dense indexes from RAW_DATA_DIR on startup if they're
# empty -- keeps ephemeral-filesystem deployments (e.g. Render free tier)
# from ever serving an empty vector database. Safe to leave true; it's a
# no-op once the indexes already exist.
AUTO_INGEST_ON_STARTUP=true

# --- LLM provider: "ollama" | "openai_compatible" | "mock" ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_API_BASE=http://localhost:11434
# Only needed for LLM_PROVIDER=openai_compatible. Never commit a real key.
OPENAI_API_KEY=
HF_TOKEN=

# --- Embeddings / vector store ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_DB_PATH=./data/processed/chroma
VECTOR_DB_COLLECTION=docuverify_chunks

# --- BM25 ---
BM25_INDEX_PATH=./data/processed/bm25_index.pkl

# --- Retrieval ---
TOP_K=8
HYBRID_ALPHA=0.6
MAX_RETRIEVAL_ATTEMPTS=3
EVIDENCE_SUFFICIENCY_THRESHOLD=0.55

# --- Chunking ---
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# --- Groundedness classifier ---
GROUNDEDNESS_MODEL=./models/groundedness-classifier
GROUNDEDNESS_BASE_MODEL=microsoft/deberta-v3-small
GROUNDEDNESS_MAX_LENGTH=512

# --- Ingestion ---
RAW_DATA_DIR=./data/raw

# --- Misc ---
REQUEST_TIMEOUT_SECONDS=30
